{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build DSA-FA Hospital Management System",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "main.cpp",
                "HospitalSystem.cpp",
                "PatientBST.cpp",
                "Input.cpp",
                "MedicalHistory.cpp",
                "ServiceQueue.cpp",
                "ReferralGraph.cpp",
                "Algorithms.cpp",
                "HospitalLifecycle.cpp",
                "Persistence.cpp",
                "ScheduleBook.cpp",
                "EmergencyQueue.cpp",
                "PharmacyInventory.cpp",
                "PrescriptionManager.cpp",
                "BillingSystem.cpp",
                "HospitalCommerce.cpp",
                "-o",
                "HospitalManagement.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
